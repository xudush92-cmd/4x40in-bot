# ─────────────────────────────────────────────────────────────────────
# ENGINEBOT v1.1 — Atrof-muhit oʻzgaruvchilari
# ─────────────────────────────────────────────────────────────────────
# Bu fayl namuna sifatida. Haqiqiy ishlatish uchun:
#   cp .env.example .env
#   va quyidagi qiymatlarni toʻldiring.
# ─────────────────────────────────────────────────────────────────────


# ════════════════════════════════════════════════════════════════════
# 1. MAJBURIY (bot ishlamaydi bularsiz)
# ════════════════════════════════════════════════════════════════════

# Bot tokeni (@BotFather'dan oling)
BOT_TOKEN=123456:ABC-DEF-your-real-token-here

# Super Admin Telegram ID (siz — bot egasi)
# O'z ID'ngizni olish: @userinfobot ga "/start" yuboring
SUPER_ADMIN_ID=123456789


# ════════════════════════════════════════════════════════════════════
# 2. STORAGE (default qiymatlar bor)
# ════════════════════════════════════════════════════════════════════

# SQLite baza yoʻli (default: data/enginebot.db)
# DB_PATH=data/enginebot.db


# ════════════════════════════════════════════════════════════════════
# 3. LOGGING
# ════════════════════════════════════════════════════════════════════

# Logging darajasi: DEBUG / INFO / WARNING / ERROR (default: INFO)
# LOG_LEVEL=INFO


# ════════════════════════════════════════════════════════════════════
# 4. HEALTH/MONITORING (kelajakda HTTP endpoint uchun)
# ════════════════════════════════════════════════════════════════════

# Health server porti (default: 8080)
# HEALTH_PORT=8080

# Health server bind adresi (0.0.0.0 = barcha, 127.0.0.1 = faqat lokal)
# HEALTH_HOST=0.0.0.0

# /stats endpointni himoyalash uchun token (boʻsh boʻlsa faqat localhost)
# Production'da har doim qo'ying!
# HEALTH_TOKEN=long-random-secret-string


# ════════════════════════════════════════════════════════════════════
# 5. TIMEZONE
# ════════════════════════════════════════════════════════════════════

# Standart soat mintaqasi (UTC offset, O'zbekiston: 5)
# DEFAULT_TZ_OFFSET=5


# ════════════════════════════════════════════════════════════════════
# 6. BILLING / TARIF
# ════════════════════════════════════════════════════════════════════
# Eslatma: ENGINEBOT v1.1'da to'lov OG'ZAKI bo'shqariladi.
# Bu parametrlar — faqat trial va eslatma uchun.

# Trial muddati (kun) — yangi tenantlar uchun (default: 7)
# TRIAL_DAYS=7

# Trial/tarif tugashdan necha kun oldin eslatma yuborilsin (default: 3)
# BILLING_REMINDER_DAYS=3
