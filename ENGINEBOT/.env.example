# ─────────────────────────────────────────────────────────────────────
# ENGINEBOT — Atrof-muhit oʻzgaruvchilari
# ─────────────────────────────────────────────────────────────────────
# Bu fayl namuna sifatida. Haqiqiy ishlatish uchun:
#   cp .env.example .env
#   va quyidagi qiymatlarni toʻldiring.
# ─────────────────────────────────────────────────────────────────────

# ─── MAJBURIY ───────────────────────────────────────────────────────

# Bot tokeni (@BotFather'dan oling)
BOT_TOKEN=123456:ABC-DEF-your-real-token-here

# Super Admin Telegram ID (siz — bot egasi)
# Oʻzingiz haqingizda maʼlumot olish: @userinfobot
SUPER_ADMIN_ID=123456789

# ─── IXTIYORIY (default qiymatlar mavjud) ───────────────────────────

# SQLite baza yoʻli (default: data/enginebot.db)
# DB_PATH=data/enginebot.db

# Logging darajasi: DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# Health server porti (monitoring uchun)
# HEALTH_PORT=8080

# Health server bind adresi (0.0.0.0 = barcha, 127.0.0.1 = faqat lokal)
# HEALTH_HOST=0.0.0.0

# /stats endpointni himoyalash uchun token (boʻsh boʻlsa faqat localhost)
# HEALTH_TOKEN=long-random-secret-string

# Standart soat mintaqasi (UTC offset)
# DEFAULT_TZ_OFFSET=5

# ─── BILLING (kelajakda) ────────────────────────────────────────────

# Trial muddati (kun)
# TRIAL_DAYS=7

# Eslatma: tarif muddati tugashidan necha kun oldin yuborilsin
# BILLING_REMINDER_DAYS=3
