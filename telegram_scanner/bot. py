import asyncio
from aiogram import Bot, Dispatcher, types, F
from aiogram.filters import Command
from aiogram.types import ReplyKeyboardMarkup, KeyboardButton, InlineKeyboardMarkup, InlineKeyboardButton
from aiogram.utils.keyboard import InlineKeyboardBuilder
from config import BOT_TOKEN, ADMIN_ID
from database import (init_db, add_phrase, get_all_phrases_with_id, delete_phrase, 
                      get_groups, toggle_group, get_setting, set_setting)

bot = Bot(token=BOT_TOKEN)
dp = Dispatcher()
init_db()

# --- Klaviaturalar ---
def main_menu():
    kb = [
        [KeyboardButton(text="➕ Yangi ibora qo'shish")],
        [KeyboardButton(text="📋 Iboralar ro'yxati"), KeyboardButton(text="📋 Guruhlar ro'yxati")],
        [KeyboardButton(text="⏸ To'xtatish / ▶️ Davom ettirish")]
    ]
    return ReplyKeyboardMarkup(keyboard=kb, resize_keyboard=True)

# --- Handlers ---
@dp.message(Command("start"))
async def cmd_start(message: types.Message):
    if message.from_user.id != ADMIN_ID:
        return
    await message.answer("Assalomu alaykum! Skaner boshqaruv botiga xush kelibsiz.", reply_markup=main_menu())

@dp.message(F.text == "➕ Yangi ibora qo'shish")
async def ask_phrase(message: types.Message):
    await message.answer("Qidirmoqchi bo'lgan iborani (gapni) yuboring.\nMasalan: <i>toshkentdan qayergadir odam bor</i>", parse_mode="HTML")

@dp.message(F.text.startswith("➕") == False) # Agar menyu tugmasi bosilmasa
async def save_new_phrase(message: types.Message):
    # Faqatgina matn yuborilayotgan bo'lsa va menyudagi boshqa tugma bosilmasa
    if message.text in ["📋 Iboralar ro'yxati", "📋 Guruhlar ro'yxati", "⏸ To'xtatish / ▶️ Davom ettirish"]:
        return
        
    if len(message.text.split()) < 2:
        await message.answer("⚠️ Iltimos, kamida 2 ta so'zdan iborat gap kiriting! (Shovqinni oldini olish uchun)")
        return

    if add_phrase(message.text):
        await message.answer(f"✅ Ajoyib! Yangi ibora saqlandi: <b>{message.text}</b>\nEndi skaner aynan shu gapni qidiradi.", parse_mode="HTML")
    else:
        await message.answer("⚠️ Bu ibora allaqachon ro'yxatda bor.")

@dp.message(F.text == "📋 Iboralar ro'yxati")
async def list_phrases(message: types.Message):
    phrases = get_all_phrases_with_id()
    if not phrases:
        await message.answer("Ro'yxat bo'sh.")
        return
    
    await message.answer("Sizning iboralaringiz (o'chirish uchun tugmani bosing):")
    for p_id, p_text in phrases:
        kb = InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text="🗑 O'chirish", callback_data=f"del_{p_id}")]])
        await message.answer(f"🔹 {p_text}", reply_markup=kb)

@dp.callback_query(F.data.startswith("del_"))
async def delete_phrase_callback(callback: types.CallbackQuery):
    p_id = int(callback.data.split("_")[1])
    delete_phrase(p_id)
    await callback.message.edit_text("🗑 O'chirildi!")
    await callback.answer()

@dp.message(F.text == "📋 Guruhlar ro'yxati")
async def list_groups(message: types.Message):
    groups = get_groups()
    if not groups:
        await message.answer("Guruhlar topilmadi. Userbotni bir marta ishga tushiring.")
        return
    
    await message.answer("Guruhlarni kuzatishni yoqish/o'chirish uchun bosing:")
    for chat_id, title, is_active in groups:
        status = "✅ Kuzatilmoqda" if is_active else "❌ O'chirilgan"
        kb = InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text=status, callback_data=f"tgl_{chat_id}_{is_active}")]])
        await message.answer(f"👥 {title}", reply_markup=kb)

@dp.callback_query(F.data.startswith("tgl_"))
async def toggle_group_callback(callback: types.CallbackQuery):
    _, chat_id, current_status = callback.data.split("_")
    new_status = 0 if current_status == "1" else 1
    
    toggle_group(int(chat_id), new_status)
    
    status_text = "✅ Kuzatilmoqda" if new_status == 1 else "❌ O'chirilgan"
    kb = InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text=status_text, callback_data=f"tgl_{chat_id}_{new_status}")]])
    
    await callback.message.edit_reply_markup(reply_markup=kb)
    await callback.answer("O'zgartirildi!")

@dp.message(F.text == "⏸ To'xtatish / ▶️ Davom ettirish")
async def toggle_system(message: types.Message):
    current = get_setting('is_active')
    new_status = '0' if current == '1' else '1'
    set_setting('is_active', new_status)
    
    status_text = "⏸ To'xtatildi" if new_status == '0' else "▶️ Davom ettirildi"
    await message.answer(f"Tizim holati: <b>{status_text}</b>", parse_mode="HTML")

async def main():
    print("Boshqaruv boti ishga tushdi...")
    await dp.start_polling(bot)

if __name__ == '__main__':
    asyncio.run(main())
