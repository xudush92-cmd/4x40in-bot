# .env.example — nusxa olib ".env" deb saqlang va o'zingiznikini yozing
# my.telegram.org -> API development tools
API_ID=1234567
API_HASH=abcdef1234567890abcdef1234567890

# @BotFather dan olingan bot tokeni
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# Moslik chegarasi (ixtiyoriy): kalit so'zlarining kamida 70% i
# xabarda bo'lsa xabar beriladi. Masalan 10 so'zli kalitda 7 ta so'z.
MATCH_THRESHOLD=0.70

