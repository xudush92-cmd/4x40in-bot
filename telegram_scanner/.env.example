# .env.example — nusxa olib ".env" deb saqlang va o'zingiznikini yozing
# my.telegram.org -> API development tools
API_ID=1234567
API_HASH=abcdef1234567890abcdef1234567890

# @BotFather dan olingan bot tokeni
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ


# Sessiyalarni shifrlash kaliti (serverda alohida, maxfiy saqlang).
# Yo'q bo'lsa BOT_TOKEN dan hosil qilinadi.
SESSION_ENCRYPTION_KEY=
ADMIN_ID=123456789

# Zaxira tekshiruv: Telegram push kelmasa ham superguruh xabarlari shu
# oraliqda so'raladi. Har guruhni bitta akkaunt so'raydi (a'zolar orasida
# teng bo'linadi). Yozilmasa standart qiymatlar ishlaydi.
# SCANNER_POLL_ENABLED=1                # 0 — o'chirish
# SCANNER_POLL_INTERVAL_SECONDS=10      # bitta guruh oralig'i (3..300)
# SCANNER_POLL_ACCOUNT_GAP_SECONDS=1    # akkaunt so'rovlari orasida (0.5..10)

# Topilgan mijoz egasining "Saved Messages"iga ham saqlanadi (bosiladigan
# mijoz nomi + asl xabar nusxasi). 0 — o'chirish.
# SCANNER_SAVED_MESSAGES=1
