# ─────────────────────────────────────────────────────────────────────
# Telegram bot uchun (majburiy)
# ─────────────────────────────────────────────────────────────────────

# https://my.telegram.org/apps dan oling
API_ID=1234567
API_HASH=your_api_hash_here

# Bot tokeni (@BotFather dan)
BOT_TOKEN=123456:ABC-DEF...

# Super admin Telegram ID (raqam)
ADMIN_ID=123456789

# ─────────────────────────────────────────────────────────────────────
# Health server (ixtiyoriy)
# ─────────────────────────────────────────────────────────────────────

# /health va /stats endpoint port (default: 8080)
# HEALTH_PORT=8080

# Bind adres — 0.0.0.0 (default) yoki 127.0.0.1 (faqat localhost)
# HEALTH_HOST=0.0.0.0

# /stats endpointni tashqi monitoringga ochish uchun token
# Bo'sh bo'lsa /stats faqat localhost'dan kiriladi
# HEALTH_TOKEN=long-random-secret-string
