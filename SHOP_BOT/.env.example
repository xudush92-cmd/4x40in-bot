# ─────────────────────────────────────────────────────────────
#  SHOP-BOT — muhit o'zgaruvchilari namuna fayli
#  Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring
# ─────────────────────────────────────────────────────────────

# ── Telegram (MAJBURIY) ──────────────────────────────────────
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAA-your-real-token-here
# Super admin Telegram ID(lar) — vergul bilan: 123456789,987654321
ADMIN_IDS=123456789

# ── Ma'lumotlar bazasi ───────────────────────────────────────
# Docker Compose ichida (default) — servis nomi "postgres"
DB_URL=postgresql+asyncpg://shopbot:shopbot@postgres:5432/shopbot
# Lokal test uchun SQLite ishlatsa bo'ladi:
# DB_URL=sqlite+aiosqlite:///./data/shopbot.db
POSTGRES_USER=shopbot
POSTGRES_PASSWORD=shopbot
POSTGRES_DB=shopbot

# ── Redis (FSM, kesh, lock) ──────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Ish rejimi ───────────────────────────────────────────────
# all = bot + scheduler bitta processda (dev uchun qulay)
# bot = faqat bot | poster = faqat rejalashtiruvchi worker
RUN_MODE=all

# ── Webhook ──────────────────────────────────────────────────
# Katta yuklamada webhook tavsiya etiladi (domen + HTTPS kerak)
USE_WEBHOOK=false
# Domeningiz (Caddy uchun alohida .env da DOMAIN ham kerak)
WEBHOOK_BASE_URL=https://bot.sizning-domeningiz.uz
WEBHOOK_PATH=/webhook
# Tasodifiy uzun satr (xavfsizlik uchun majburiy)
WEBHOOK_SECRET=change-this-to-a-long-random-string

# ── Health / monitoring server ───────────────────────────────
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
# /stats endpoint uchun token (bo'sh bo'lsa faqat lokalhostdan)
HEALTH_TOKEN=

# ── Umumiy ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
TIMEZONE=Asia/Tashkent
# Xatolarni Sentry'ga yuborish (ixtiyoriy)
# SENTRY_DSN=

# ── Caddy (faqat docker-compose uchun) ───────────────────────
DOMAIN=bot.sizning-domeningiz.uz
